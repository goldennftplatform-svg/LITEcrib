# LITEcrib — environment reference (Render Blueprint fills these; see render.yaml).
# Copy to .env for local dev. NEVER commit a real seed or admin token.

# --- LITEcrib relay ----------------------------------------------------------
PORT=8080

# --- Litecoin network ---------------------------------------------------------
# testnet (default) | mainnet  — switch ONLY after testnet play is verified.
LTC_NETWORK=testnet

# Litecoin Space indexer (Litecoin Foundation). Leave default; set only if you
# run your own mempool-style indexer.
LTC_INDEXER_URL=https://litecoinspace.org/testnet/api

# Litecoin Core / hosted Litecoin RPC (Bitcoin-style JSON-RPC). Optional for
# deposits (the HD wallet derives addresses itself). Used as an extra broadcast
# path and status fallback when set. Also works with QuickNode Litecoin RPC.
LTC_RPC_URL=
LTC_RPC_USER=
LTC_RPC_PASS=

# --- Wallet (server-held custody) ---------------------------------------------
# BIP39 mnemonic for ALL player deposit addresses + payouts.
# Generate: npx bip39  — or paste an existing 12/24-word mnemonic.
# If unset, the server generates one and prints it ONCE (lost on restart!).
LITECRIB_SEED=

# Bearer token guarding POST /api/wallet/payout. Payout stays DISABLED (501)
# until this is set. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LITECRIB_ADMIN_TOKEN=

# --- LitVM seam ----------------------------------------------------------------
# LiteForge testnet (Arbitrum Orbit + BitcoinOS). Mainnet pending — keep the
# seam read-only until then.
LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/http
LITVM_CHAIN_ID=4441